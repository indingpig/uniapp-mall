# 复制为 server/.env 并填入真实值（.env 已被 gitignore，不会入库）

PORT=3001
CORS_ORIGIN=*

# ---- 监听地址 ----
# 本机开发留空（默认 0.0.0.0，手机真机调试要连局域网 IP）；
# 生产服务器必须设 127.0.0.1，让 Node 只绑回环，外部只能经反向代理进入。
# HOST=127.0.0.1

# ---- 鉴权（上公网硬前置，AGENTS.md 强制：密钥绝不写死、绝不设默认值）----
# 设备令牌：板子连 WS 时携带，配网时由 App 经 BLE 写入板子 NVS。
# 生成：openssl rand -hex 32
# 未配置时 esp32 通道整体关闭（板子连不上），这是刻意的安全默认值。
DEVICE_TOKEN=
# 鉴权强度：enforce（默认，推荐）/ off（跳过所有校验，仅固件升级过渡期用）
AUTH_MODE=enforce

# ---- ntfy 兜底推送（App 进程被杀后，server 直发系统通知的备用通道）----
# 家人手机装 ntfy App 并订阅同一主题即可接收，不依赖本 App 存活。
# 主题名在公共 ntfy.sh 上等同密码（谁订阅谁就能收）：用足够长的随机串。
# 真实主题/token 属敏感信息，严禁提交（AGENTS.md）。
NTFY_ENABLED=false
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=your-long-random-topic
NTFY_TOKEN=
NTFY_PRIORITY=high
# 哭声推送节流窗口（毫秒），防状态抖动重复推送
NTFY_CRY_THROTTLE_MS=60000
# 失联确认窗口（毫秒）：离线持续超过该时长才推「监护器失联」，防 WiFi 瞬断误报
NTFY_OFFLINE_CONFIRM_MS=60000
