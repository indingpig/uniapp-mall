# 统一行尾符：根治 manifest.json / components.d.ts 等生成文件的幻影改动与 CRLF warning
* text=auto eol=lf

# Windows 专属脚本保持 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.p12 binary
*.mobileprovision binary
*.zip binary
